{
  "name": "skillsbar-guided-walkthrough",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "assets:qr": "node scripts/generate-skillsbar-qr.mjs public",
    "assets:cover": "xcrun swift scripts/generate-skillsbar-cover.swift public/og.png"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.62.1",
    "pngjs": "5.0.0",
    "qrcode": "1.5.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    },
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "type": "module"
}
